# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.js

# all node modules
package-lock.json
!frontend/package-lock.json
# Ignore all node_modules folders
node_modules/
frontend/node_modules/
backend/node_modules/
*/node_modules


# testing
/coverage

# production
/build
frontend/build/
*.zip
frontend_updated_files_only/

# misc
.DS_Store
.env.local
.env.development.local
.env.test.local
.env.production.local

npm-debug.log*
yarn-debug.log*
yarn-error.log*


# local env files
.env
google_project_json
client_secret*.json

# Ignore compiled Python files
__pycache__/
*.pyc

# remove .db files
*.db
.venv/
*.db-wal
*.db-shm
.pytest_cache/
frontend/review-artifacts/
